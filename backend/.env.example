# Required: get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the model (default gemini-3.8-flash)
GEMINI_MODEL=
# Optional but recommended once deployed: the app must send this in the X-App-Token header
APP_TOKEN=
# Optional: Netscape cookies.txt exported from a logged-in browser, helps when Instagram demands login
YTDLP_COOKIES_FILE=
